# syntax=docker/dockerfile:1
# Windows（*-pc-windows-msvc）クロスビルド + 成果物エクスポート専用イメージ
#
# messense/cargo-xwin で MSVC ABI 向けにクロスビルドする。Dockerfile.glibc と同じ
# 「cacher（依存だけ先にビルド）→ builder（実ソース）」の 2 段構成にすることで、
# ソース変更のたびに aws-lc-sys / boring-sys（quiche 内蔵 BoringSSL）の重い C ビルドを
# やり直さずに済む（従来の packaging/scripts/build-cross.sh は毎回フルビルドだった）。
#
# ランタイムステージは持たない（Windows バイナリは Linux コンテナで実行できない）。
# 最終ステージ `artifact` は scratch に veil.exe だけを置き、
#   docker build --target artifact --output type=local,dest=<dir>
# で取り出す。
#
# ARG:
#   RUST_TARGET     x86_64-pc-windows-msvc / aarch64-pc-windows-msvc
#   CARGO_FEATURES  既定 full-windows（full と同じ http3 + wasm 含む全機能。アロケータは mimalloc。F-184）
#
# AWS_LC_SYS_NO_PREFIX は .cargo/config.toml の [env]（ターゲット接尾辞付き変数）で
# 一元管理する。Windows は "0"（quiche は内蔵 BoringSSL を使うため、aws-lc-sys の
# シンボルはプレフィックスしたままにして共存させる）。B-47 / F-131。

# ==========================================
# 1. ツールチェーンステージ
# ==========================================
FROM messense/cargo-xwin:latest@sha256:9856b895265d4966f212228ba64802cf89337e2a2a537aa2533c1b8784cbc81b AS tool-builder

WORKDIR /app

# aws-lc-sys（cmake 必須）と boring-sys のビルドに必要なツール
RUN apt-get update -y \
    && apt-get install -y --no-install-recommends \
        cmake \
        nasm \
        yasm \
        perl \
        golang-go \
    && rm -rf /var/lib/apt/lists/*

ARG RUST_TARGET=x86_64-pc-windows-msvc

# MSVC ABI 向けの C/C++ ツールチェーン（clang-cl / llvm-ar）と、
# アセンブリ実装を避けるためのフラグ（MSVC 向け ml64/armasm が無いため）。
# B-167: 配布する veil.exe は C ランタイムを静的にリンクする（+crt-static）。動的だと VCRUNTIME140.dll（Visual C++
# 再頒布パッケージ）を読み込み、それが入っていない素の Windows（winget の検証の sandbox など）で起動できない。
# cc・cmake のクレートは crt-static を見て C の依存（aws-lc-sys・boring-sys・libmimalloc-sys）も /MT で組み立てる。
# cargo-xwin はこの変数を自分の rustflags に足して使う。dist.yml が成果物の import を check-pe-imports.py で確かめる
ENV CMAKE_SYSTEM_NAME=Windows \
    CC_x86_64_pc_windows_msvc=clang-cl \
    CXX_x86_64_pc_windows_msvc=clang-cl \
    AR_x86_64_pc_windows_msvc=llvm-ar \
    CC_aarch64_pc_windows_msvc=clang-cl \
    CXX_aarch64_pc_windows_msvc=clang-cl \
    AR_aarch64_pc_windows_msvc=llvm-ar \
    CFLAGS=-DOPENSSL_NO_ASM \
    CXXFLAGS=-DOPENSSL_NO_ASM \
    BORING_BSSL_NO_ASM=1 \
    XWIN_CACHE_DIR=/xwin-cache \
    CARGO_TARGET_X86_64_PC_WINDOWS_MSVC_RUSTFLAGS="-C target-feature=+crt-static" \
    CARGO_TARGET_AARCH64_PC_WINDOWS_MSVC_RUSTFLAGS="-C target-feature=+crt-static" \
    CMAKE=/usr/local/bin/cmake-msvc-static

# B-167: cargo-xwin が作る CMake の toolchain は `set(CMAKE_MSVC_RUNTIME_LIBRARY CACHE STRING "MultiThreaded")` で、値が
# 説明の欄に入って変数が空のままになる（cargo-xwin 0.23 で確認）。CMake 3.15 以降の既定（/MD）で BoringSSL（boring-sys）が
# 組み立てられ、/MT の Rust・cc の物とリンクで RuntimeLibrary の不一致になる。BoringSSL は cmake_minimum_required(3.10) で
# CMP0091 が未設定（変数を見ずに CMAKE_<LANG>_FLAGS_<CONFIG> の既定の /MD を使う）なので、その既定も NEW にする。
# cmake の crate は環境変数 CMAKE の実行ファイルを使うので、構成のときだけこの 2 つを足す
RUN printf '%s\n' '#!/bin/sh' \
      'case " $* " in *" --build "*|*" -E "*|*" -P "*|*" --version "*|*" --install "*) exec cmake "$@" ;; esac' \
      'exec cmake -DCMAKE_POLICY_DEFAULT_CMP0091=NEW -DCMAKE_MSVC_RUNTIME_LIBRARY=MultiThreaded "$@"' > /usr/local/bin/cmake-msvc-static \
    && chmod +x /usr/local/bin/cmake-msvc-static

# ==========================================
# 2. 依存ライブラリの事前ビルドステージ
# ==========================================
FROM tool-builder AS cacher

ARG CARGO_FEATURES=full-windows
ARG RUST_TARGET=x86_64-pc-windows-msvc

# Cargo.toml と Cargo.lock、および fuzz ワークスペースメンバのマニフェストを先にコピー
# （[workspace] members = [".", "fuzz"] のため、fuzz/Cargo.toml が無いとワークスペース解決に失敗する）
COPY Cargo.toml Cargo.lock /app/
COPY .cargo/config.toml /app/.cargo/config.toml
COPY build.rs /app/build.rs
COPY fuzz/Cargo.toml /app/fuzz/Cargo.toml
# third_party/wasmtime はルート Cargo.toml が参照するパス依存クレート（B-55）。
# 本ターゲットではビルドされなくても、マニフェストが無いと cargo のワークスペース解決自体が失敗する
COPY third_party /app/third_party
# crates/（veil-macros・veil-capi・veil-python・veil-build・veil-kit）はワークスペースメンバー（F-188）。本体はこれらを
# ビルドしないが、マニフェストが無いとワークスペース解決に失敗する（小さいので丸ごとコピーする）
COPY crates /app/crates

# F-184: builder 段と同じ dist プロファイルでビルドする（以前は --release で、出力先
# target/<triple>/release と target/<triple>/dist が別になるため builder 段で依存を全部
# ビルドし直していた。時間もディスクも 2 倍かかり、macOS ではホストのディスクを使い切った）。
# 空の main.rs / lib.rs を作り、依存関係「だけ」を先にコンパイルしてキャッシュ化する。
# xwin の Windows SDK ダウンロードもこの層で完了させ、以降の再ビルドで再取得しない。
RUN mkdir src benches \
    && echo "fn main() {}" > src/main.rs \
    && echo "" > src/lib.rs \
    && awk -F'"' '/^\[\[bench\]\]/{p=1} p && /name =/{print $2; p=0}' Cargo.toml \
       | xargs -I {} touch benches/{}.rs \
    && awk -F'"' '/^path =/{print $2}' fuzz/Cargo.toml \
       | while read -r p; do mkdir -p "fuzz/$(dirname "$p")" && echo "fn main() {}" > "fuzz/$p"; done \
    && cargo xwin build --profile dist --target "${RUST_TARGET}" \
         --no-default-features --features "${CARGO_FEATURES}" --locked \
    && rm -rf src/

# ==========================================
# 3. アプリケーションコードのビルドステージ
# ==========================================
FROM tool-builder AS builder

ARG CARGO_FEATURES=full-windows
ARG RUST_TARGET=x86_64-pc-windows-msvc

# cacher ステージから「ビルド済みの依存関係アセット」を引き継ぐ
COPY --from=cacher /usr/local/cargo /usr/local/cargo
COPY --from=cacher /xwin-cache /xwin-cache
COPY --from=cacher /app/target /app/target
COPY --from=cacher /app/benches /app/benches

# ソースコードをコピー
COPY . /app

# cacher 段はスタブの src/main.rs / src/lib.rs で release 成果物をキャッシュしている。
# 実ソースへ差し替えた後は全 .rs の mtime を更新して再コンパイルを強制する
# （main.rs だけ touch すると lib のスタブ成果物が最新と誤判定され veil::run 未定義になる）。
RUN find src -name '*.rs' -exec touch {} + \
    && cargo xwin build --profile dist --target "${RUST_TARGET}" \
         --no-default-features --features "${CARGO_FEATURES}" --locked

# ==========================================
# 4. 成果物エクスポートステージ
# ==========================================
# `--output type=local` は snap 版 Docker のように daemon がファイル所有権を
# 設定できない環境で `lchownat: operation not permitted` になるため、
# **イメージとして tag → `docker create` + `docker cp` で取り出す**方式にする
# （packaging/scripts/build-cross.sh がこの手順を実行する）。
# scratch イメージでも `docker create` できるよう ENTRYPOINT を置いておく
# （コンテナは起動せず、ファイル取り出しにしか使わない）。
FROM scratch AS artifact

ARG RUST_TARGET=x86_64-pc-windows-msvc

COPY --from=builder /app/target/${RUST_TARGET}/dist/veil.exe /veil.exe

ENTRYPOINT ["/veil.exe"]
