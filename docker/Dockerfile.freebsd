# syntax=docker/dockerfile:1
# FreeBSD x86_64（x86_64-unknown-freebsd）クロスビルド + 成果物エクスポート専用イメージ
#
# messense/cargo-zigbuild で FreeBSD 向けにクロスビルドする。Zig は FreeBSD の libc
# ヘッダ/スタブを同梱しているため（`zig cc -target x86_64-freebsd-none` が通る）、
# aarch64 と違い x86_64-unknown-freebsd は Rust Tier 2 で prebuilt std が入手でき、
# Docker だけでクロスビルドできる。
#
#   - x86_64-unknown-freebsd  : 本 Dockerfile（Docker クロスビルド）
#   - aarch64-unknown-freebsd : Rust Tier 3（prebuilt std 無し）のため QEMU VM 内
#                               ネイティブビルド（tools/qemu/bsd-vm.sh freebsd aarch64）
#
# Dockerfile.glibc と同じ「cacher（依存だけ先にビルド）→ builder（実ソース）」構成で
# aws-lc-sys の重い C ビルドをキャッシュする。
#
# ランタイムステージは持たない（FreeBSD バイナリは Linux コンテナで実行できない）。
# 最終ステージ `artifact` は scratch に veil だけを置き、
#   docker build --target artifact --output type=local,dest=<dir>
# で取り出して QEMU VM へ転送し、tests/e2e_setup.sh で動作確認する。
#
# AWS_LC_SYS_NO_PREFIX は .cargo/config.toml の [env]（ターゲット接尾辞付き変数）で
# 一元管理する。FreeBSD は "1"（quiche と aws-lc-sys のシンボル共有）。B-47 / F-131。

# ==========================================
# 1. ツールチェーンステージ
# ==========================================
FROM messense/cargo-zigbuild AS tool-builder

WORKDIR /app

# aws-lc-sys（cmake + bindgen/libclang 必須）のビルドに必要なツール
RUN apt-get update -y \
    && apt-get install -y --no-install-recommends \
        cmake \
        nasm \
        yasm \
        perl \
        golang-go \
        clang \
        libclang-dev \
    && rm -rf /var/lib/apt/lists/*

ARG RUST_TARGET=x86_64-unknown-freebsd

# FreeBSD 向け prebuilt std（Tier 2）を追加
RUN rustup target add "${RUST_TARGET}"

# bindgen（aws-lc-sys）は cargo-zigbuild の `zig cc` ラッパを経由せず clang を直接呼ぶため、
# Zig 同梱の FreeBSD libc ヘッダを -isystem で明示する必要がある。
# Zig の lib ディレクトリはイメージのバージョンに依存するのでビルド時に解決し、
# 以降のステージから読める場所（/zig-freebsd-includes）へ集約する。
RUN ZL="$(dirname "$(readlink -f "$(command -v zig)")")/lib" \
    && [ -d "$ZL/libc/include/generic-freebsd" ] || ZL="$(ls -d /usr/local/zig-*/lib | head -1)" \
    && mkdir -p /zig-freebsd-includes \
    && cp -a "$ZL/libc/include/generic-freebsd" /zig-freebsd-includes/ \
    && cp -a "$ZL/libc/include/x86_64-freebsd-none" /zig-freebsd-includes/ \
    && ls /zig-freebsd-includes

# CMAKE_SYSTEM_NAME は **あえて設定しない**（B-49）。
# aws-lc-sys は cmake ビルダを使う（`ssl` フィーチャーが必要で、cc ビルダは
# "cc_builder for libssl not supported" になるため cmake 一択）。その cmake 設定は
# cmake-rs が TARGET から CMAKE_SYSTEM_NAME と **CMAKE_SYSTEM_PROCESSOR** を
# 揃えて導出する。ここで CMAKE_SYSTEM_NAME だけを手で与えると PROCESSOR が
# 伴わず、aws-lc の CMakeLists がアーキテクチャを判定できずアセンブリを無効化し、
# s2n-bignum の `.S`（curve25519 / edwards25519 / bignum_*）が 1 つも組み立てられない。
# 一方 aws-lc の C 側は `OPENSSL_FREEBSD` により `CURVE25519_S2N_BIGNUM_CAPABLE` を
# 立ててこれらを呼ぶため、リンク時に `undefined symbol: curve25519_x25519_byte` などが
# 多数出る。導出を cmake-rs に任せることで整合させる。
ENV BINDGEN_EXTRA_CLANG_ARGS_x86_64_unknown_freebsd="--target=x86_64-unknown-freebsd -isystem /zig-freebsd-includes/x86_64-freebsd-none -isystem /zig-freebsd-includes/generic-freebsd"

# ==========================================
# 2. 依存ライブラリの事前ビルドステージ
# ==========================================
FROM tool-builder AS cacher

ARG CARGO_FEATURES=full-freebsd
ARG RUST_TARGET=x86_64-unknown-freebsd

# Cargo.toml と Cargo.lock、および fuzz ワークスペースメンバのマニフェストを先にコピー
# （[workspace] members = [".", "fuzz"] のため、fuzz/Cargo.toml が無いとワークスペース解決に失敗する）
COPY Cargo.toml Cargo.lock /app/
COPY .cargo/config.toml /app/.cargo/config.toml
COPY build.rs /app/build.rs
COPY fuzz/Cargo.toml /app/fuzz/Cargo.toml

# 空の main.rs / lib.rs を作り、依存関係「だけ」を先にコンパイルしてキャッシュ化する
RUN mkdir src benches \
    && echo "fn main() {}" > src/main.rs \
    && echo "" > src/lib.rs \
    && awk -F'"' '/^\[\[bench\]\]/{p=1} p && /name =/{print $2; p=0}' Cargo.toml \
       | xargs -I {} touch benches/{}.rs \
    && awk -F'"' '/^path =/{print $2}' fuzz/Cargo.toml \
       | while read -r p; do mkdir -p "fuzz/$(dirname "$p")" && echo "fn main() {}" > "fuzz/$p"; done \
    && cargo zigbuild --release --target "${RUST_TARGET}" \
         --no-default-features --features "${CARGO_FEATURES}" --locked \
    && rm -rf src/

# ==========================================
# 3. アプリケーションコードのビルドステージ
# ==========================================
FROM tool-builder AS builder

ARG CARGO_FEATURES=full-freebsd
ARG RUST_TARGET=x86_64-unknown-freebsd

COPY --from=cacher /usr/local/cargo /usr/local/cargo
COPY --from=cacher /app/target /app/target
COPY --from=cacher /app/benches /app/benches

COPY . /app

# cacher 段のスタブ成果物を確実に置き換えるため全 .rs の mtime を更新する
RUN find src -name '*.rs' -exec touch {} + \
    && cargo zigbuild --release --target "${RUST_TARGET}" \
         --no-default-features --features "${CARGO_FEATURES}" --locked

# ==========================================
# 4. 成果物エクスポートステージ
# ==========================================
# `--output type=local` は snap 版 Docker のように daemon がファイル所有権を
# 設定できない環境で `lchownat: operation not permitted` になるため、
# **イメージとして tag → `docker create` + `docker cp` で取り出す**方式にする
# （packaging/scripts/build-cross.sh がこの手順を実行する）。
# scratch イメージでも `docker create` できるよう ENTRYPOINT を置いておく
# （コンテナは起動せず、ファイル取り出しにしか使わない）。
FROM scratch AS artifact

ARG RUST_TARGET=x86_64-unknown-freebsd

COPY --from=builder /app/target/${RUST_TARGET}/release/veil /veil

ENTRYPOINT ["/veil"]
