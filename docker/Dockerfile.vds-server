# syntax=docker/dockerfile:1
# VDS の参照制御プレーン（tools/vds/server、F-199。gRPC + REST）のイメージ。
#
#   docker build -f docker/Dockerfile.vds-server -t veil-vds-server:latest .
#   docker run --rm -v $PWD/snapshot.toml:/etc/vds/snapshot.toml -p 18000:18000 veil-vds-server:latest \
#       --snapshot /etc/vds/snapshot.toml --listen 0.0.0.0:18000
#
# 本体（veil）とは独立したクレート。テスト・小規模運用向けの参照実装（本番は自前の制御プレーンを推奨）。

FROM rust:1-bookworm@sha256:48b7f435b8fc6378ce43b44f15e3a47fd8919b2825f835c39bd4bd3da50af5b8 AS builder
RUN apt-get update -y \
    && apt-get install -y --no-install-recommends protobuf-compiler cmake \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY proto /src/proto
COPY tools/vds/server /src/tools/vds/server
RUN cd tools/vds/server && cargo build --release --locked \
    && cp target/release/veil-vds-server /veil-vds-server

# distroless の Debian の libc6 には直す版の無い（won't fix）High の脆弱性が残るので、本体の glibc 版と同じ
# Wolfi の glibc-dynamic にする（libgcc・libstdc++ を含み、既定のユーザーは nonroot=65532。B-158）
FROM cgr.dev/chainguard/glibc-dynamic:latest@sha256:5bb932663cff4fb276186720e0357af55c5e47f12e4d9f44ea0060fa3e7bca88
COPY --from=builder /veil-vds-server /usr/local/bin/veil-vds-server
USER 65532:65532
EXPOSE 18000
ENTRYPOINT ["/usr/local/bin/veil-vds-server"]
CMD ["--snapshot", "/etc/vds/snapshot.toml", "--listen", "0.0.0.0:18000"]
