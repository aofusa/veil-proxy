# syntax=docker/dockerfile:1
# glibc 2.28 向け aarch64 クロスビルド + Wolfi（Chainguard の glibc-dynamic）ランタイム
#
# F-120 Phase 3: Dockerfile.glibc をベースに aarch64-unknown-linux-gnu 向けの
# クロスコンパイル差分のみを適用したもの（builder は x86_64 イメージ上で
# cargo-zigbuild により aarch64 バイナリを生成する）。
#
# Dockerfile.glibc との主な差分:
#   - RUST_TARGET のデフォルトを aarch64-unknown-linux-gnu に変更
#   - `rustup target add aarch64-unknown-linux-gnu` を追加
#   - `cargo test --bins --no-run --target ...` / `cargo test --lib --target ...`
#     を省略する（理由: cargo-zigbuild が差し替えるのは `cargo zigbuild` コマンドの
#     リンカ選択のみであり、素の `cargo test --target aarch64-unknown-linux-gnu`
#     はホストの `cc`（x86_64 用リンカ）を使おうとしてリンクに失敗する。
#     加えて、たとえリンクできたとしても x86_64 ビルダー上で aarch64 テスト
#     バイナリを実行することはできない。x86_64 ビルド（Dockerfile.glibc）側で
#     すでにユニットテストは実行されているため、aarch64 版では省略する）
#   - ランタイムステージのベースイメージに `--platform=linux/arm64` を指定
#   - ビルダーステージを `linux/amd64` にピン（下記）
#
# `docker build --platform` は **コンパイルターゲットを決めない**。決めるのは
# この Dockerfile と RUST_TARGET（cargo-zigbuild のクロスコンパイル）である。
# `--platform` が決めるのは「ピンしていない全 FROM の既定プラットフォーム」と
# 「最終イメージの OCI Architecture」だけ。ビルダーを未ピンのままにすると
# `docker build --platform linux/arm64` が arm64 の cargo-zigbuild を引きに行き、
# **rustc 一式が QEMU エミュレーション上で動いて極端に遅くなる**（実測で
# x86_64 ネイティブなら十数分の依存ビルドが数時間規模になった）。
# musl 版（Dockerfile.musl.aarch64）は当初からビルダーを amd64 にピンしている。

# FROM で参照する ARG は最初の FROM より前に宣言する必要がある。
# 定数の直書きは BuildKit の FromPlatformFlagConstDisallowed lint に触れるため ARG 経由。
# ビルダーは x86_64 ホストでネイティブに動かす（QEMU 上で rustc を回さない）。
ARG BUILDER_PLATFORM=linux/amd64
# ランタイムステージの --platform 用（既定値は常に linux/arm64）。
# これがあるので glibc 側は `docker build --platform` を付けなくても
# 最終イメージが linux/arm64 として記録される。
ARG RUNTIME_PLATFORM=linux/arm64

# ==========================================
# 1. 最小設定ファイルやツールを用意する共通ステージ
# ==========================================
FROM --platform=${BUILDER_PLATFORM} messense/cargo-zigbuild AS tool-builder

WORKDIR /app

# 依存パッケージのインストール
RUN apt-get update -y \
    && apt-get install -y --no-install-recommends \
        nasm \
        cmake \
    && rm -rf /var/lib/apt/lists/*

# aarch64 クロスビルド用ターゲットを追加（x86_64 ビルダー上でのクロスコンパイル用）
RUN rustup target add aarch64-unknown-linux-gnu

# キャッシュディレクトリの事前準備
RUN mkdir -p /var/cache/veil /var/tmp/veil

# ==========================================
# 2. 依存ライブラリの事前ビルドステージ
# ==========================================
FROM tool-builder AS cacher

ARG CARGO_FEATURES=full
# F-237: 空でなければ、この feature で 2 本目（epoll 版）もビルドして /veil.epoll に置く。io_uring 版の /veil は
# 起動時に io_uring が使えなければ（Docker の既定の seccomp・RuntimeDefault）これへ切り替える
# （src/runtime/fallback.rs）。公開イメージは使わない（CARGO_FEATURES=full-container の 1 本。docker/README.md）
ARG CARGO_FEATURES_FALLBACK=
ARG RUST_TARGET=aarch64-unknown-linux-gnu
ARG LIBC_VERSION=.2.28
# AWS_LC_SYS_NO_PREFIX は .cargo/config.toml の [env]（ターゲット接尾辞付き変数）で
# 一元管理する（Linux ターゲットは "1" = quiche と aws-lc-sys のシンボル共有）。
# ここで非接尾辞版の ENV を設定すると設定箇所が二重化し食い違いの原因になるため設定しない（B-47）。


# Cargo.toml と Cargo.lock、および fuzz ワークスペースメンバのマニフェストを先にコピー
# （[workspace] members = [".", "fuzz"] のため、fuzz/Cargo.toml が無いとワークスペース解決に失敗する）
COPY Cargo.toml Cargo.lock /app/
COPY .cargo/config.toml /app/.cargo/config.toml
COPY build.rs /app/build.rs
COPY fuzz/Cargo.toml /app/fuzz/Cargo.toml
# third_party/wasmtime はルート Cargo.toml が参照するパス依存クレート（B-55）。
# 本ターゲットではビルドされなくても、マニフェストが無いと cargo のワークスペース解決自体が失敗する
COPY third_party /app/third_party
# crates/（veil-macros・veil-capi・veil-python）はワークスペースメンバー（F-188）。本体はこれらを
# ビルドしないが、マニフェストが無いとワークスペース解決に失敗する（小さいので丸ごとコピーする）
COPY crates /app/crates

# F-184: builder 段と同じ dist プロファイルでビルドする（以前は --release で、出力先
# target/<triple>/release と target/<triple>/dist が別になるため builder 段で依存を全部
# ビルドし直していた。時間もディスクも 2 倍かかっていた）。
# 空の main.rs を作り、依存関係「だけ」を先にコンパイルしてキャッシュ化する
# fuzz メンバはワークスペース解決のためにスタブのターゲットだけ用意し、本体はビルドしない
#
# 注: cargo-zigbuild は `cargo zigbuild` コマンドでのみクロスリンクを担うため、
# `cargo test --no-run` によるテストバイナリの事前キャッシュ（x86_64 版で実施）は
# aarch64 では行わない（上記コメント参照）。依存キャッシュは `cargo zigbuild` の
# 成果物のみで賄う。
RUN mkdir src benches \
    && echo "fn main() {}" > src/main.rs \
    # 本クレートは lib + bin 構成（src/lib.rs）。--bins ビルドでも lib ターゲットが
    # コンパイルされるため、依存キャッシュ段では空の lib スタブが必要。
    && echo "" > src/lib.rs \
    # Cargo.toml から name = "xxx"（ベンチマーク名）を抽出して、自動的にダミーファイルを一括作成
    && awk -F'"' '/^\[\[bench\]\]/{p=1} p && /name =/{print $2; p=0}' Cargo.toml \
       | xargs -I {} touch benches/{}.rs \
    # fuzz/Cargo.toml の [[bin]] path = "..." を抽出し、スタブソースを生成
    && awk -F'"' '/^path =/{print $2}' fuzz/Cargo.toml \
       | while read -r p; do mkdir -p "fuzz/$(dirname "$p")" && echo "fn main() {}" > "fuzz/$p"; done \
    && cargo zigbuild --profile dist --target "${RUST_TARGET}${LIBC_VERSION}" --features "${CARGO_FEATURES}" --locked \
    && if [ -n "${CARGO_FEATURES_FALLBACK}" ]; then cargo zigbuild --profile dist --target "${RUST_TARGET}${LIBC_VERSION}" --features "${CARGO_FEATURES_FALLBACK}" --locked; fi \
    && rm -rf src/


# ==========================================
# 3. アプリケーションコードのビルドステージ
# ==========================================
FROM tool-builder AS builder

ARG CARGO_FEATURES=full
# F-237: 空でなければ、この feature で 2 本目（epoll 版）もビルドして /veil.epoll に置く。io_uring 版の /veil は
# 起動時に io_uring が使えなければ（Docker の既定の seccomp・RuntimeDefault）これへ切り替える
# （src/runtime/fallback.rs）。公開イメージは使わない（CARGO_FEATURES=full-container の 1 本。docker/README.md）
ARG CARGO_FEATURES_FALLBACK=
ARG RUST_TARGET=aarch64-unknown-linux-gnu
ARG LIBC_VERSION=.2.28

# cacher ステージから「ビルド済みの依存関係アセット（target/）」をコピー
COPY --from=cacher /usr/local/cargo /usr/local/cargo
COPY --from=cacher /app/target /app/target
COPY --from=cacher /app/benches /app/benches
COPY Cargo.toml Cargo.lock /app/
COPY .cargo/config.toml /app/.cargo/config.toml
COPY build.rs /app/build.rs

# ソースコードをコピー
COPY . /app

# ビルド（aarch64 バイナリは x86_64 ビルダー上で実行できないため、ユニットテストは
# 実行しない。x86_64 ビルド（Dockerfile.glibc）側で同一ソースのテストが実行されている）。
#
# cacher 段はスタブの src/main.rs / src/lib.rs で release プロファイルの成果物をキャッシュする。
# 実ソースへ差し替えた後は全 .rs の mtime を更新して cargo に再コンパイルを強制する
# （main.rs だけ touch すると lib のスタブ成果物が最新と誤判定され veil::run 未定義になる）。
RUN find src -name '*.rs' -exec touch {} + \
    && cargo zigbuild --profile dist --target "${RUST_TARGET}${LIBC_VERSION}" --features "${CARGO_FEATURES}" --locked \
    && mkdir -p /app/out && cp target/${RUST_TARGET}/dist/veil /app/out/veil \
    && if [ -n "${CARGO_FEATURES_FALLBACK}" ]; then cargo zigbuild --profile dist --target "${RUST_TARGET}${LIBC_VERSION}" --features "${CARGO_FEATURES_FALLBACK}" --locked \
        && cp target/${RUST_TARGET}/dist/veil /app/out/veil.epoll; fi


# ==========================================
# 4. 最終実行用ランタイム（Chainguard の glibc-dynamic、arm64）
# ==========================================
# B-158: 以前の distroless/base-nossl-debian13 は Debian の libc6 に、Debian が直さない（won't fix）High の脆弱性が
# 残っていた。Wolfi の glibc は上流の修正を取り込んで更新されるので、glibc 版はこちらにする（grype で High 以上 0 件）。
# 中身は distroless と同じ最小構成（glibc・libgcc・CA 証明書・/etc/passwd の nonroot=65532）で、シェルは無い。
# 既定のユーザーは nonroot（65532）だが、distroless（root で起動し、設定の drop_privileges で降格する）と
# 同じ振る舞いにするため root で起動する。作業ディレクトリも CMD の `./veil` のために / に固定する。
# --platform はファイル冒頭で宣言した RUNTIME_PLATFORM を使う
FROM --platform=${RUNTIME_PLATFORM} cgr.dev/chainguard/glibc-dynamic:latest AS runtime

ARG RUST_TARGET=aarch64-unknown-linux-gnu
ARG LIBC_VERSION=.2.28

# ディスク書き込みが発生するディレクトリの構造と所有権の持込
COPY --from=builder --chown=65532:65532 /var/cache/veil /var/cache/veil
COPY --from=builder --chown=65532:65532 /var/tmp/veil /var/tmp/veil

# アプリケーションバイナリと設定アセット
# /veil と（ビルドしていれば）/veil.epoll
COPY --from=builder /app/out/ /
# 既定の設定とページ（F-246）: 何もマウントしなくても `docker run -p 8080:8080 <image>` で /var/www を 8080 で配る。
# 試験（tools/container_security）は docker/assets/conf.d/config.toml を -v で渡して使う。
COPY --from=builder /app/packaging/container/config.toml /etc/veil/conf.d/config.toml
COPY --from=builder /app/packaging/container/www/ /var/www/

USER 0:0
WORKDIR /

EXPOSE 8080/tcp 80/tcp 443/tcp 443/udp

CMD ["./veil", "-c", "/etc/veil/conf.d/config.toml"]
