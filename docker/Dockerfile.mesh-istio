# Istio のサイドカー・ゲートウェイ用イメージ（F-222）: istio/proxyv2 の Envoy を veil（musl 版）に差し替える。
#
# pilot-agent・iptables（istio-init）・ブートストラップのテンプレートは istio/proxyv2 のものをそのまま使い、
# pilot-agent が起動する `/usr/local/bin/envoy`（ProxyConfig.binaryPath の既定）だけを veil にする。
# veil は docker/Dockerfile.musl で `mesh-istio` を有効にしてビルドした静的リンクのバイナリ。
#
#   docker build -f docker/Dockerfile.musl --build-arg CARGO_FEATURES=mesh-istio,mesh-linkerd,epoll,wasm -t veil:musl-mesh .
#   docker build -f docker/Dockerfile.mesh-istio -t veil.local/istio-proxy:1.31.1 .
#
# 注入: Pod の注釈 `sidecar.istio.io/proxyImage: veil.local/istio-proxy:1.31.1`（`/` を含む名前でないと注入テンプレートが無視する）（または istioctl install の
# `--set values.global.proxy.image=...`）。
ARG ISTIO_PROXY_IMAGE=docker.io/istio/proxyv2:1.31.1@sha256:d86cba0dd1eb15c00b6901c69ce5ae3d2d5f8427a47751098cf8c3ab2a4a62e9
ARG VEIL_IMAGE=veil:musl-mesh
FROM ${VEIL_IMAGE} AS veil
FROM ${ISTIO_PROXY_IMAGE}
COPY --from=veil /veil /usr/local/bin/envoy
