          "expr": "sum by (status) (rate(veil_proxy_http_requests_total{job=~\"$job\",instance=~\"$instance\",host=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
