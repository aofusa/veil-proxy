        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(veil_proxy_http_requests_total{job=~\"$job\",instance=~\"$instance\",host=~\"$host\",status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(veil_proxy_http_requests_total{job=~\"$job\",instance=~\"$instance\",host=~\"$host\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "5xx",
          "refId": "A"
