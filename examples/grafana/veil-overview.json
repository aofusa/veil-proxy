{
  "title": "veil overview",
  "uid": "veil-overview",
  "description": "Traffic, latency, upstreams, cache, gRPC, Proxy-Wasm and VDS of veil (https://github.com/aofusa/veil-proxy).",
  "tags": [
    "veil",
    "proxy"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "links": [
    {
      "title": "veil metrics",
      "type": "link",
      "targetBlank": true,
      "url": "https://github.com/aofusa/veil-proxy/blob/main/docs/guide/observability.md"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(veil_proxy_http_requests_total, job)",
          "refId": "job"
        },
        "definition": "label_values(veil_proxy_http_requests_total, job)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(veil_proxy_http_requests_total{job=~\"$job\"}, instance)",
          "refId": "instance"
        },
        "definition": "label_values(veil_proxy_http_requests_total{job=~\"$job\"}, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(veil_proxy_http_requests_total{job=~\"$job\"}, host)",
          "refId": "host"
        },
        "definition": "label_values(veil_proxy_http_requests_total{job=~\"$job\"}, host)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "upstream",
        "label": "Upstream",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(veil_proxy_http_upstream_health{job=~\"$job\"}, upstream)",
          "refId": "upstream"
        },
        "definition": "label_values(veil_proxy_http_upstream_health{job=~\"$job\"}, upstream)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
