# F-251: deb / rpm の試験用（systemd が PID 1 のコンテナ）。BASE は ubuntu・debian・fedora・rockylinux・almalinux・amazonlinux
ARG BASE=ubuntu:24.04
FROM ${BASE}
RUN if command -v apt-get >/dev/null; then \
        export DEBIAN_FRONTEND=noninteractive; apt-get update -qq \
        && apt-get install -y -qq --no-install-recommends systemd systemd-sysv dbus curl ca-certificates gnupg \
        && apt-get clean && rm -rf /var/lib/apt/lists/*; \
    else \
        (dnf install -y --allowerasing systemd curl ca-certificates gnupg2 shadow-utils procps-ng \
         || dnf install -y systemd curl ca-certificates gnupg2 shadow-utils procps-ng) && dnf clean all; \
    fi \
    && (ln -sf /lib/systemd/systemd /sbin/init 2>/dev/null || true)
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
