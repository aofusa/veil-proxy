# Generated by tools/release/homebrew-formula.sh from packaging/homebrew/veil.rb.in (F-250). Do not edit by hand.
class Veil < Formula
  desc "High-performance reverse proxy and web server (HTTP/1.1, HTTP/2, HTTP/3)"
  homepage "https://github.com/aofusa/veil-proxy"
  license any_of: ["MIT", "Apache-2.0"]

  # One universal2 archive for both Apple silicon and Intel.
  on_macos do
    on_arm do
      url "@BASE@/veil-@VERSION@-universal2-apple-darwin.tar.gz"
      sha256 "@SHA_MACOS@"
    end
    on_intel do
      url "@BASE@/veil-@VERSION@-universal2-apple-darwin.tar.gz"
      sha256 "@SHA_MACOS@"
    end
  end
  on_linux do
    on_intel do
      url "@BASE@/veil-@VERSION@-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@SHA_LINUX_X86_64@"
    end
    on_arm do
      url "@BASE@/veil-@VERSION@-aarch64-unknown-linux-musl.tar.gz"
      sha256 "@SHA_LINUX_AARCH64@"
    end
  end

  def install
    libexec.install "veil"
    # The default page and configuration (the archive's example, pointed at the installed page).
    pkgshare.install "examples/www"
    header = <<~EOS
      # Default configuration installed by the veil Homebrew formula (#{etc}/veil/config.toml).
      #
      #   brew services start veil      # or: veil      then open http://127.0.0.1:8080/
      #
      # Edit this file and run `brew services restart veil`. Upgrades keep your changes.
      # Every key: https://github.com/aofusa/veil-proxy/blob/main/examples/config.toml
    EOS
    config = File.read("examples/config.toml").sub(/\A(#.*\n)+/, header)
                 .gsub("examples/www", "#{opt_pkgshare}/www")
    (buildpath/"config.toml").write config
    # Homebrew keeps an existing etc/veil/config.toml and writes the new one as config.toml.default.
    (etc/"veil").install "config.toml"
    # veil reads -c, then VEIL_CONFIG, then /etc/veil/config.toml: point the default at Homebrew's etc.
    (bin/"veil").write_env_script libexec/"veil", VEIL_CONFIG: "${VEIL_CONFIG:-#{etc}/veil/config.toml}"
    doc.install "README.md", "LICENSE-APACHE", "LICENSE-MIT"
  end

  def caveats
    <<~EOS
      The default configuration is #{etc}/veil/config.toml and serves #{opt_pkgshare}/www
      on http://127.0.0.1:8080/. Start it with:
        brew services start veil      # or just: veil
      Edit the configuration and run `brew services restart veil`.
    EOS
  end

  service do
    run [opt_bin/"veil"]
    keep_alive true
    working_dir var
    log_path var/"log/veil.log"
    error_log_path var/"log/veil.log"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/veil --version")
    # The wrapper makes the installed configuration the default; -t also checks that the page directory exists.
    assert_match "#{etc}/veil/config.toml", shell_output("#{bin}/veil -t")
    # Without a configuration file veil stops and names the path it looked for.
    output = shell_output("#{libexec}/veil -c #{testpath}/missing.toml 2>&1", 1)
    assert_match "configuration file not found", output
  end
end
