#!/bin/sh
#
# FreeBSD rc.d サービススクリプト（veil、F-120 Phase 6）
#
# インストール:
#   install -m 0555 veil.rc /usr/local/etc/rc.d/veil
#   sysrc veil_enable=YES
#   service veil start
#
# 設定ファイル: /usr/local/etc/veil/config.toml（veil_config で変更可）
#
# PROVIDE: veil
# REQUIRE: LOGIN cleanvar
# KEYWORD: shutdown

. /etc/rc.subr

name="veil"
rcvar="veil_enable"

load_rc_config "$name"

: ${veil_enable:="NO"}
: ${veil_config:="/usr/local/etc/veil/config.toml"}
: ${veil_user:="root"}

# daemon(8) が veil を監視する（-r で再起動）。pidfile は daemon 自身の pid（stop は daemon へ SIGTERM、daemon が veil へ
# 転送して終わる）。veil の pid は child_pidfile（reload の SIGHUP は daemon が転送しないので veil へ直接送る）
pidfile="/var/run/${name}_daemon.pid"
child_pidfile="/var/run/${name}.pid"
veil_bin="/usr/local/bin/veil"
command="/usr/sbin/daemon"
command_args="-P ${pidfile} -p ${child_pidfile} -r -f ${veil_bin} -c ${veil_config}"

# 設定リロード（SIGHUP でホットリロード）
extra_commands="reload configtest"
reload_cmd="veil_reload"
configtest_cmd="veil_configtest"

veil_reload()
{
    if [ -f "${child_pidfile}" ]; then
        kill -HUP "$(cat "${child_pidfile}")" && echo "veil: reloaded"
    else
        echo "veil: not running"
    fi
}

veil_configtest()
{
    ${veil_bin} -t -c "${veil_config}"
}

run_rc_command "$1"
