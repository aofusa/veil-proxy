# Generated by tools/release/bsd-ports.py from packaging/bsd/ports/openbsd/www/veil/Makefile.in (F-253).
COMMENT =		high-performance reverse proxy and web server

DIST_TUPLE =		github aofusa veil-proxy @GH_TAG@ .
PKGNAME =		veil-@PKGVERSION@
CATEGORIES =		www
HOMEPAGE =		https://github.com/aofusa/veil-proxy
MAINTAINER =		aofusa <aofusa@users.noreply.github.com>

# Apache-2.0 OR MIT
PERMIT_PACKAGE =	Yes

WANTLIB +=		${COMPILER_LIBCXX} c c++abi m pthread

MODULES =		devel/cargo lang/clang
MODCLANG_COMPILER_LINKS =	No
BUILD_DEPENDS =		devel/cmake \
			devel/gmake \
			devel/protobuf \
			shells/bash

CONFIGURE_STYLE =	cargo
MODCARGO_NO_DEFAULT_FEATURES =	Yes
MODCARGO_FEATURES =	full-openbsd
MODCARGO_INSTALL_TARGET_PATHS =	.

# veil reads /etc/veil/config.toml by default. BoringSSL (quiche) expects pthread_rwlock_t from <sys/types.h>:
# the C files are compiled with a wrapper that includes <pthread.h> first (files/veil-cc), bindgen gets the same.
MAKE_ENV +=		VEIL_DEFAULT_CONFIG_PATH=${SYSCONFDIR}/veil/config.toml \
			LIBCLANG_PATH=${LOCALBASE}/llvm${MODCLANG_VERSION}/lib \
			CC_${MACHINE_ARCH:S/amd64/x86_64/:S/arm64/aarch64/}_unknown_openbsd=${WRKDIR}/veil-cc \
			BINDGEN_EXTRA_CLANG_ARGS="-include pthread.h" \
			CFLAGS_aarch64_unknown_openbsd="-DOPENSSL_STATIC_ARMCAP -DOPENSSL_STATIC_ARMCAP_NEON" \
			RUSTFLAGS="-L ${WRKDIR}/lib"

pre-configure:
	${INSTALL_SCRIPT} ${FILESDIR}/veil-cc ${WRKDIR}/veil-cc
	# boring-sys links -lstdc++; OpenBSD's C++ library is libc++
	mkdir -p ${WRKDIR}/lib
	ln -sf /usr/lib/libc++.so.* ${WRKDIR}/lib/libstdc++.so

post-build:
	${LOCALBASE}/bin/bash ${WRKSRC}/tools/release/render-defaults.sh ports-openbsd \
		${WRKDIR}/defaults --www-dir ${PREFIX}/share/veil/www/

post-install:
	${INSTALL_DATA_DIR} ${PREFIX}/share/examples/veil ${PREFIX}/share/veil/www
	${INSTALL_DATA} ${WRKDIR}/defaults/config.toml ${PREFIX}/share/examples/veil/config.toml
	${INSTALL_DATA} ${WRKDIR}/defaults/www/index.html ${WRKDIR}/defaults/www/quickstart.html \
		${PREFIX}/share/veil/www/

.include "crates.inc"

.include <bsd.port.mk>
