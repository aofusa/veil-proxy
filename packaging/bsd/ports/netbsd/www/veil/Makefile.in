# Generated by tools/release/bsd-ports.py from packaging/bsd/ports/netbsd/www/veil/Makefile.in (F-253).

DISTNAME=	veil-proxy-@PKGVERSION@
PKGNAME=	veil-@PKGVERSION@
CATEGORIES=	www
GITHUB_PROJECT=	veil-proxy
GITHUB_TAG=	@GH_TAG@
MASTER_SITES=	${MASTER_SITE_GITHUB:=aofusa/}

MAINTAINER=	aofusa@users.noreply.github.com
HOMEPAGE=	https://github.com/aofusa/veil-proxy
COMMENT=	High-performance reverse proxy and web server
LICENSE=	apache-2.0 OR mit

TOOL_DEPENDS+=	cmake-[0-9]*:../../devel/cmake
# git: boring-sys (BoringSSL for HTTP/3) applies its patches with git init / git apply
TOOL_DEPENDS+=	git-base-[0-9]*:../../devel/git-base
TOOL_DEPENDS+=	protobuf-[0-9]*:../../devel/protobuf
TOOL_DEPENDS+=	bash-[0-9]*:../../shells/bash
TOOL_DEPENDS+=	clang-[0-9]*:../../lang/clang
TOOL_DEPENDS+=	nasm-[0-9]*:../../devel/nasm

USE_LANGUAGES=	c c++
USE_TOOLS+=	gmake pkg-config

CARGO_NO_DEFAULT_FEATURES=	yes
CARGO_FEATURES=	full-netbsd
# veil reads ${PKG_SYSCONFDIR}/veil/config.toml by default (built in at compile time).
MAKE_ENV+=	VEIL_DEFAULT_CONFIG_PATH=${PKG_SYSCONFDIR}/veil/config.toml
MAKE_ENV+=	LIBCLANG_PATH=${PREFIX}/lib
.if ${MACHINE_ARCH} == "aarch64"
MAKE_ENV+=	CFLAGS_aarch64_unknown_netbsd="-DOPENSSL_STATIC_ARMCAP -DOPENSSL_STATIC_ARMCAP_NEON"
.endif

# wasmtime needs to map executable memory (PaX MPROTECT is on by default).
NOT_PAX_MPROTECT_SAFE+=	bin/veil

PKG_SYSCONFSUBDIR=	veil
EGDIR=		${PREFIX}/share/examples/veil
CONF_FILES=	${EGDIR}/config.toml ${PKG_SYSCONFDIR}/config.toml
RCD_SCRIPTS=	veil
PKG_USERS=	veil:veil
PKG_GROUPS=	veil
INSTALLATION_DIRS=	bin ${EGDIR} share/veil/www

post-build:
	${PREFIX}/bin/bash ${WRKSRC}/tools/release/render-defaults.sh ports-netbsd \
		${WRKDIR}/defaults --www-dir ${PREFIX}/share/veil/www/

do-install:
	${INSTALL_PROGRAM} ${WRKSRC}/target/release/veil ${DESTDIR}${PREFIX}/bin/veil
	${INSTALL_DATA} ${WRKDIR}/defaults/config.toml ${DESTDIR}${EGDIR}/config.toml
	${INSTALL_DATA} ${WRKDIR}/defaults/www/index.html ${WRKDIR}/defaults/www/quickstart.html \
		${DESTDIR}${PREFIX}/share/veil/www/

.include "cargo-depends.mk"

.include "../../lang/rust/cargo.mk"
.include "../../mk/bsd.pkg.mk"
