# Generated by tools/release/bsd-ports.py from packaging/bsd/ports/freebsd/www/veil/Makefile.in (F-253).
PORTNAME=	veil
DISTVERSIONPREFIX=	v
DISTVERSION=	@VERSION@
CATEGORIES=	www

MAINTAINER=	aofusa@users.noreply.github.com
COMMENT=	High-performance reverse proxy and web server
WWW=		https://github.com/aofusa/veil-proxy

LICENSE=	APACHE20 MIT
LICENSE_COMB=	dual
LICENSE_FILE_APACHE20=	${WRKSRC}/LICENSE-APACHE
LICENSE_FILE_MIT=	${WRKSRC}/LICENSE-MIT

BUILD_DEPENDS=	bash:shells/bash \
		cmake:devel/cmake-core \
		gmake:devel/gmake \
		nasm:devel/nasm \
		protoc:devel/protobuf

USES=		cargo llvm:build
USE_GITHUB=	yes
GH_ACCOUNT=	aofusa
GH_PROJECT=	veil-proxy
@GH_TAGNAME@
USE_RC_SUBR=	veil

CARGO_FEATURES=	--no-default-features full-freebsd
CARGO_INSTALL_PATH=	.
# veil reads ${PREFIX}/etc/veil/config.toml by default (built in at compile time).
CARGO_ENV+=	VEIL_DEFAULT_CONFIG_PATH=${PREFIX}/etc/veil/config.toml \
		LIBCLANG_PATH=${LLVM_PREFIX}/lib

SUB_FILES=	pkg-message

post-build:
	${LOCALBASE}/bin/bash ${WRKSRC}/tools/release/render-defaults.sh ports-freebsd \
		${WRKDIR}/defaults --www-dir ${DATADIR}/www/

post-install:
	${MKDIR} ${STAGEDIR}${ETCDIR} ${STAGEDIR}${DATADIR}/www
	${INSTALL_DATA} ${WRKDIR}/defaults/config.toml ${STAGEDIR}${ETCDIR}/config.toml.sample
	${INSTALL_DATA} ${WRKDIR}/defaults/www/index.html ${WRKDIR}/defaults/www/quickstart.html \
		${STAGEDIR}${DATADIR}/www/

.include <bsd.port.mk>
