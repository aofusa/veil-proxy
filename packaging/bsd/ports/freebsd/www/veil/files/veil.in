#!/bin/sh

# PROVIDE: veil
# REQUIRE: LOGIN cleanvar
# KEYWORD: shutdown
#
# veil_enable (bool):	Set to YES to enable veil. Default: NO
# veil_config (str):	Configuration file. Default: %%PREFIX%%/etc/veil/config.toml
#			(veil's built-in default path; set it only to use another file)

. /etc/rc.subr

name="veil"
rcvar="veil_enable"

load_rc_config "$name"

: ${veil_enable:="NO"}
: ${veil_config:="%%PREFIX%%/etc/veil/config.toml"}

# daemon(8) supervises veil (-r restarts it). pidfile is the supervisor's: stop sends SIGTERM to daemon, which
# forwards it to veil and exits. veil's own pid is in child_pidfile, used for reload (daemon does not forward SIGHUP).
pidfile="/var/run/${name}_daemon.pid"
child_pidfile="/var/run/${name}.pid"
veil_bin="%%PREFIX%%/bin/veil"
command="/usr/sbin/daemon"
command_args="-P ${pidfile} -p ${child_pidfile} -r -f -o /var/log/veil.log ${veil_bin} -c ${veil_config}"
required_files="${veil_config}"

extra_commands="reload configtest"
reload_cmd="veil_reload"
configtest_cmd="veil_configtest"
start_precmd="veil_configtest"

veil_reload()
{
	if [ -f "${child_pidfile}" ]; then
		kill -HUP "$(cat "${child_pidfile}")" && echo "veil: reloaded"
	else
		echo "veil: not running"
	fi
}

veil_configtest()
{
	${veil_bin} -t -c "${veil_config}"
}

run_rc_command "$1"
